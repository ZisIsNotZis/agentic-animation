{
  "$ref": "#/definitions/library-index",
  "definitions": {
    "library-index": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "character",
            "background"
          ]
        },
        "entries": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^_?[a-z0-9][a-z0-9_-]*$"
              },
              "latest": {
                "type": "integer",
                "exclusiveMinimum": 0
              },
              "versions": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "exclusiveMinimum": 0
                },
                "minItems": 1
              }
            },
            "required": [
              "id",
              "latest",
              "versions"
            ],
            "additionalProperties": false
          },
          "default": []
        }
      },
      "required": [
        "kind"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
