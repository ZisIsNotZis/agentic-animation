{
  "$ref": "#/definitions/timeline",
  "definitions": {
    "timeline": {
      "type": "object",
      "properties": {
        "generatedBy": {
          "type": "object",
          "properties": {
            "stage": {
              "type": "string"
            },
            "tool": {
              "type": "string"
            },
            "at": {
              "type": "string"
            },
            "inputHash": {
              "type": "string"
            }
          },
          "required": [
            "stage",
            "tool",
            "at"
          ],
          "additionalProperties": false
        },
        "title": {
          "type": "string"
        },
        "subtitle": {
          "type": "string"
        },
        "total": {
          "type": "number",
          "minimum": 0
        },
        "scenes": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^_?[a-z0-9][a-z0-9_-]*$"
              },
              "name": {
                "type": "string"
              },
              "display": {
                "type": "string"
              },
              "mood": {
                "type": "string",
                "enum": [
                  "mystic",
                  "festive",
                  "tense",
                  "tender",
                  "triumphant",
                  "somber",
                  "suspense"
                ]
              },
              "start": {
                "type": "number",
                "minimum": 0
              },
              "narrAt": {
                "type": "number",
                "minimum": 0
              },
              "narrDur": {
                "type": "number",
                "minimum": 0
              },
              "dur": {
                "type": "number",
                "minimum": 0
              },
              "end": {
                "type": "number",
                "minimum": 0
              },
              "dialogue": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "$ref": "#/definitions/timeline/properties/scenes/items/properties/id"
                    },
                    "characterId": {
                      "$ref": "#/definitions/timeline/properties/scenes/items/properties/id"
                    },
                    "start": {
                      "type": "number",
                      "minimum": 0
                    },
                    "dur": {
                      "type": "number",
                      "minimum": 0
                    }
                  },
                  "required": [
                    "id",
                    "characterId",
                    "start",
                    "dur"
                  ],
                  "additionalProperties": false
                },
                "default": []
              }
            },
            "required": [
              "id",
              "start",
              "narrAt",
              "narrDur",
              "dur",
              "end"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "total",
        "scenes"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
