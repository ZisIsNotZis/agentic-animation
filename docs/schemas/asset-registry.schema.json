{
  "$ref": "#/definitions/asset-registry",
  "definitions": {
    "asset-registry": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "const": "registry"
        },
        "assets": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "capabilities": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "default": []
              },
              "dependencies": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                },
                "default": []
              },
              "hash": {
                "type": "string",
                "pattern": "^sha256:[a-f0-9]{64}$"
              },
              "identity": {
                "type": "string",
                "pattern": "^(?:figure|voice|set|prop|dressing|layout)(?:\\/[a-z][a-z0-9_]*)+$"
              },
              "kind": {
                "type": "string",
                "enum": [
                  "figure",
                  "voice",
                  "set",
                  "prop",
                  "dressing",
                  "layout"
                ]
              }
            },
            "required": [
              "identity",
              "kind"
            ],
            "additionalProperties": false
          },
          "default": []
        },
        "procedures": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "procedure"
              },
              "id": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]*(?:\\.[a-z][a-z0-9_]*)+$"
              },
              "owner": {
                "type": "string",
                "enum": [
                  "actor",
                  "object",
                  "camera",
                  "vfx",
                  "sfx",
                  "music"
                ]
              },
              "procedureKind": {
                "type": "string",
                "enum": [
                  "timed",
                  "state",
                  "speech"
                ]
              },
              "subjects": {
                "type": "array",
                "items": {
                  "type": "string",
                  "enum": [
                    "actor",
                    "camera",
                    "vfx",
                    "sfx",
                    "music"
                  ]
                },
                "minItems": 1
              },
              "positional": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "name": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "^[a-z][a-z0-9_]*$"
                    },
                    "type": {
                      "type": "string",
                      "enum": [
                        "actor",
                        "object",
                        "dressing",
                        "entity",
                        "asset",
                        "string",
                        "number",
                        "boolean"
                      ]
                    },
                    "required": {
                      "type": "boolean",
                      "default": true
                    },
                    "default": {
                      "type": [
                        "string",
                        "number",
                        "boolean"
                      ]
                    },
                    "enum": {
                      "type": "array",
                      "items": {
                        "type": [
                          "string",
                          "number",
                          "boolean"
                        ]
                      },
                      "minItems": 1
                    },
                    "min": {
                      "type": "number"
                    },
                    "max": {
                      "type": "number"
                    }
                  },
                  "required": [
                    "name",
                    "type"
                  ],
                  "additionalProperties": false
                },
                "default": []
              },
              "modifiers": {
                "type": "object",
                "additionalProperties": {
                  "$ref": "#/definitions/asset-registry/properties/procedures/items/properties/positional/items"
                },
                "default": {}
              },
              "params": {
                "type": "array",
                "items": {
                  "$ref": "#/definitions/asset-registry/properties/procedures/items/properties/positional/items"
                }
              },
              "arity": {
                "type": "integer",
                "minimum": 0
              },
              "timing": {
                "type": "object",
                "properties": {
                  "defaultDuration": {
                    "type": "number",
                    "exclusiveMinimum": 0
                  },
                  "scalable": {
                    "type": "boolean"
                  },
                  "span": {
                    "type": "object",
                    "properties": {
                      "enter": {
                        "type": "object",
                        "properties": {
                          "min": {
                            "type": "number"
                          },
                          "max": {
                            "type": "number"
                          }
                        },
                        "required": [
                          "min",
                          "max"
                        ],
                        "additionalProperties": false
                      },
                      "sustain": {
                        "$ref": "#/definitions/asset-registry/properties/procedures/items/properties/timing/properties/span/properties/enter"
                      },
                      "exit": {
                        "$ref": "#/definitions/asset-registry/properties/procedures/items/properties/timing/properties/span/properties/enter"
                      }
                    },
                    "required": [
                      "enter",
                      "sustain",
                      "exit"
                    ],
                    "additionalProperties": false
                  }
                },
                "required": [
                  "defaultDuration",
                  "scalable"
                ],
                "additionalProperties": false
              },
              "claims": {
                "type": "object",
                "properties": {
                  "exclusive": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  },
                  "shared": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    }
                  }
                },
                "additionalProperties": false
              },
              "recipe": {
                "type": "object",
                "additionalProperties": {},
                "default": {}
              }
            },
            "required": [
              "kind",
              "id",
              "subjects"
            ],
            "additionalProperties": false
          },
          "default": []
        }
      },
      "required": [
        "kind"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
