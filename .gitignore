# --- dependencies -----------------------------------------------------------
node_modules/

# --- build outputs and caches ------------------------------------------------
*.tsbuildinfo
node_modules/.cache/

# --- local scratch, temporary workspaces, generated QA material --------------
.tmp/
**/.tmp/
.scratch/
**/screenshots/
**/screenshot-*.png
**/*-screenshot.png
**/contact-sheet*.png
**/asset-contact-sheet.png

# --- pinned binaries and per-machine state -----------------------------------
vendor/*
!vendor/.gitkeep
py/.venv/
py/**/__pycache__/
py/**/*.pyc
anim.config.local.json
.anim/

# --- generated episode material -----------------------------------------------
# Hand-authored and AI-authored SOURCES are tracked: episode.yml, library
# manifests and svg/png assets, audio/*.txt sidecars. Program-GENERATED files
# are ignored. Video is the one exception: episode deliveries (dist/*.mp4)
# are published in the repository.
episodes/*/dist/*
!episodes/*/dist/*.mp4
episodes/*/audio/*
!episodes/*/audio/*.txt
episodes/*/build/
episodes/*/cues/
episodes/*/timeline.json
episodes/*/episode.build.json
episodes/*/performance.json
episodes/*/golden.json

# --- generated media everywhere else (library cues, tmp renders) --------------
/*.mp4
/*.mov
*.mov
*.webm
*.mkv
*.avi
*.wav
*.mp3
*.ogg
*.flac
*.m4a
*.aac
*.srt
*.vtt

# --- OS / editor cruft ---------------------------------------------------------
.DS_Store
Thumbs.db
*.log

# Common local caches and temporary workspaces
__pycache__/
.pi/
worktrees/
.worktrees/

# Local secrets, test caches, and generated logs
.pytest_cache/
.ruff_cache/
.mypy_cache/
.cache/
.env
.env.*
!.env.example
